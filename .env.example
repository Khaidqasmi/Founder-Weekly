# Public application URLs
NEXT_PUBLIC_APP_URL=https://your-domain.example
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only platform credentials — never prefix these with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
CRON_SECRET=

# Ecom Panel's single central Shopify public app
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_INSTALL_URL=https://apps.shopify.com/your-app-handle
# Add read_all_orders only after Shopify grants the protected access request.
SHOPIFY_SCOPES=read_orders,read_products,read_inventory,read_analytics,read_customers,read_reports

# Ecom Panel's single central Meta app
META_APP_ID=
META_APP_SECRET=

# Ecom Panel's single Google Cloud OAuth web client
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=

# Optional services
AI_API_KEY=
AI_API_URL=
AI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
